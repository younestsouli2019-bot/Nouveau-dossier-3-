name: Org Broadcast
on:
  workflow_dispatch:
  schedule:
    - cron: "15 * * * *"

permissions:
  contents: read

concurrency:
  group: org-broadcast
  cancel-in-progress: false

jobs:
  broadcast:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - name: Setup gh auth using bot/App token
        env:
          ORG_TOKEN: ${{ secrets.ORG_APP_TOKEN || secrets.ORG_BOT_PAT || secrets.ORG_PAT }}
        run: |
          set -euo pipefail
          if [ -n "${ORG_TOKEN}" ]; then
            echo "${ORG_TOKEN}" | gh auth login --with-token
          else
            echo "ORG token missing; broadcast will be skipped."
          fi
      - name: Broadcast repository_dispatch to org repos
        if: ${{ env.ORG_TOKEN != '' && env.GITHUB_ORG != '' }}
        env:
          GITHUB_ORG: ${{ secrets.GITHUB_ORG }}
          GITHUB_REPOS: ${{ secrets.GITHUB_REPOS }}
        run: |
          set -e
          repos="${GITHUB_REPOS}"
          if [ -z "${repos}" ]; then
            repos=$(gh repo list "${GITHUB_ORG}" --json nameWithOwner -q '.[].nameWithOwner')
          fi
          for r in ${repos}; do
            echo "Dispatching to ${r}"
            gh api repos/${r}/dispatches -f event_type=agentic_tick || true
          done
