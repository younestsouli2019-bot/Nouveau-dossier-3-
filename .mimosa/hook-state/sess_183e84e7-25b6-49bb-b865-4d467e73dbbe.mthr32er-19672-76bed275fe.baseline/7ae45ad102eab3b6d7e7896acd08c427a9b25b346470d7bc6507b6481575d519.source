{
    "name": "supply-chain-swarm",
    "version": "3.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "build": "prisma generate && next build",
        "start": "next start",
        "lint": "next lint",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "postinstall": "prisma generate",
        "db:push": "prisma db push",
        "db:generate": "prisma generate",
        "db:seed-pos": "node scripts/seed-pos.mjs",
        "carrier:health": "node -e \"import('./src/lib/carrier-tracking.ts').then(m => m.healthCheck().then(console.log))\"",
        "carrier:acquire": "tsx scripts/carrier-acquire-sweep.ts",
        "prod:migrate": "tsx scripts/apply-crbt-migration.ts",
        "proc:reconcile": "tsx scripts/proc-reconcile.ts",
        "proc:status": "tsx scripts/proc-status-check.ts"
    },
    "dependencies": {
        "@base44/sdk": "^0.8.13",
        "@prisma/client": "^5.22.0",
        "@radix-ui/react-alert-dialog": "^1.1.23",
        "@radix-ui/react-dialog": "^1.0.0",
        "@radix-ui/react-progress": "^1.1.16",
        "@radix-ui/react-scroll-area": "^1.0.0",
        "@radix-ui/react-select": "^2.0.0",
        "@radix-ui/react-separator": "^1.0.0",
        "@radix-ui/react-tabs": "^1.0.0",
        "@radix-ui/react-tooltip": "^1.0.0",
        "@tailwindcss/postcss": "^4.3.3",
        "autoprefixer": "^10.5.4",
        "ccxt": "^4.5.76",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.1",
        "date-fns": "^3.0.0",
        "dotenv": "^16.6.1",
        "ethers": "^6.0.0",
        "framer-motion": "^11.0.0",
        "geist": "^1.7.2",
        "lucide-react": "^1.33.0",
        "next": "^14.2.0",
        "next-themes": "^0.3.0",
        "pg": "^8.23.0",
        "postcss": "^8.5.26",
        "prisma": "^5.22.0",
        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "recharts": "^3.10.1",
        "sonner": "^1.0.0",
        "tailwind-merge": "^2.6.1",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "tweetnacl": "^1.0.3"
    },
    "devDependencies": {
        "@types/node": "^20.14.0",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "eslint": "^8.57.0",
        "tsx": "^4.19.0",
        "typescript": "^5.5.0",
        "vitest": "^2.1.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
