{
	"name": "swarm-base44-revenue-events",
	"private": true,
	"type": "module",
	"scripts": {
		"emit:revenue": "node ./src/emit-revenue-events.mjs",
		"status:reality-check": "node ./src/autonomous-daemon.mjs --reality-check",
		"approve:batch": "node ./src/emit-revenue-events.mjs --approve-payout-batch",
		"rollback:batch": "node ./src/emit-revenue-events.mjs --cancel-payout-batch",
		"prepare:sweep": "node ./src/prepare-revenue-sweep.mjs",
		"auto:settle:owner": "node ./scripts/auto-settle-owner.mjs",
		"ap2:verify": "node ./src/ap2-verify.mjs",
		"ap2:orchestrate": "node ./src/orchestrate-settlement.mjs",
		"prepare:external:settlement": "node ./src/prepare-external-settlement.mjs",
		"paypal:webhook": "node ./src/paypal-webhook-server.mjs",
		"paypal:webhook:check": "node ./src/paypal-webhook-server.mjs --check",
		"paypal:sync:payout": "node ./src/sync-paypal-payout-batch.mjs",
		"paypal:create:order": "node ./src/create-paypal-order.mjs",
		"monitor:health": "node ./src/monitor-health.mjs",
		"monitor:once": "node ./src/monitor-health.mjs --once",
		"live:readiness": "node ./src/monitor-health.mjs --readiness",
		"live:readiness:ping": "node ./src/monitor-health.mjs --readiness --ping",
		"autonomous:daemon": "node ./src/autonomous-daemon.mjs",
		"autonomous:once": "node ./src/autonomous-daemon.mjs --once",
		"check:all-good": "node ./src/autonomous-daemon.mjs --all-good",
		"check:simulation": "node ./src/emit-revenue-events.mjs --check-simulation",
		"agent:coordinator": "node ./src/agent-coordinator.mjs",
		"test": "node --test",
		"lint": "biome check src",
		"lint:fix": "eslint src scripts --ext .js,.mjs --fix",
		"lint:apply": "biome check --apply src",
		"crypto:prepare:cryptobox": "node ./scripts/prepare-cryptobox-instruction.mjs",
		"revenue:materialize:csv": "node ./scripts/materialize-revenue-csv.mjs",
		"env:validate:owner-routing": "node ./scripts/validate-owner-routing-env.mjs",
		"owner:routes:update": "node ./scripts/update-owner-routes.mjs",
		"secrets:org:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/gh-sync-org-secrets.ps1 -Org $env:GITHUB_ORG -Repos $env:GITHUB_REPOS",
		"env:bulk:update": "node ./scripts/env-bulk-update.mjs",
		"swarm:replenish": "node ./scripts/replenish-agents.mjs",
		"swarm:supervise": "node ./src/swarm/supervisor.mjs",
		"format": "biome format --write src",
		"watchdog:readiness": "npm run env:validate:owner-routing && npm run live:readiness",
		"mobile:autorun": "node ./src/mobile-hardening.mjs --autorun",
		"catalogue:wire": "node ./src/wire-images.mjs"
	},
	"dependencies": {
		"@base44/sdk": "^0.8.13",
		"@binance/connector": "^3.6.1",
		"base64-js": "^1.5.1",
		"body-parser": "^2.2.1",
		"ccxt": "^4.5.32",
		"dotenv": "^16.6.1",
		"ethers": "^6.0.0",
		"express": "^5.2.1",
		"tweetnacl": "^1.0.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"eslint": "^9.39.2",
		"eslint-formatter-compact": "^9.0.1",
		"globals": "^17.0.0"
	}
}
