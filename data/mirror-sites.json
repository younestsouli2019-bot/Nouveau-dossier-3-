  "routing": {
    "strategy": "geo-latency-with-censorship-bypass",
    "fallbackOrder": ["mirror-cf-us-eu", "mirror-bunny-apac", "mirror-gh-pages", "mirror-ipfs", "mirror-onion", "mirror-i2p"],
    "healthCheckIntervalMs": 30000,
    "maxFailoverTimeMs": 5000,
    "censorshipBypass": {
      "enabled": true,
      "autoPromoteOnionOnBlock": true,
      "autoPromoteI2POnBlock": true,
      "blockThresholdSeconds": 30
    }
  },
  "restoreDrill": {
    "enabled": true,
    "scheduleCron": "0 8 * * 1",
    "requireProof": true,
    "proofDir": "data/swarm/continuity",
    "autoRestoreThreshold": "RED",
    "playbooks": {
      "partial_outage": "restore_single_mirror",
      "full_outage": "restore_all_mirrors",
      "data_corruption": "restore_from_encrypted_backup",
      "censorship_block": "promote_onion_mirror",
      "doomsday_scenario": "quorum_restore_vault"
    }
