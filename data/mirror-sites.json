{
  "$schema": "./mirror-sites.schema.json",
  "created": "2026-07-30T00:00:00.000Z",
  "updated": "2026-07-30T00:00:00.000Z",
  "defaultEncryption": {
    "algorithm": "aes-256-gcm",
    "keyDerivation": "PBKDF2-HMAC-SHA256",
    "iterations": 600000,
    "authTagLength": 16,
    "integrity": "HMAC-SHA256",
    "splitKeyQuorum": { "totalShares": 5, "required": 3 }
  },
  "antiCensorship": {
    "enabled": true,
    "probeEndpoints": ["https://check.torproject.org", "https://www.cloudflare.com/cdn-cgi/trace"],
    "regionalBlockDetect": {
      "intervalMs": 3600000,
      "timeoutMs": 10000,
      "suspectedBlockThreshold": 2
    },
    "providerDiversity": {
      "jurisdictionsRequired": ["US", "EU", "CH", "RU-region"],
      "minDistinctProviders": 4,
      "minDistinctJurisdictions": 3
    },
    "failoverCascade": ["clearnet-cdn", "onion-mirror", "i2p-mirror", "ipfs-gateway", "local-cache"]
  },
  "doomsdayVault": {
    "enabled": true,
    "intervalDays": 1,
    "retentionSnapshots": 30,
    "vaultDir": "data/doomsday-vault",
    "geoReplicas": [
      { "region": "EU-Central", "provider": "Infomaniak", "syncCron": "0 4 * * *" },
      { "region": "US-East", "provider": "Backblaze B2", "syncCron": "0 5 * * *" },
      { "region": "APAC", "provider": "Scaleway", "syncCron": "0 6 * * *" }
    ],
    "quorumRestore": { "totalShares": 5, "required": 3 },
    "integrityCheck": { "algorithm": "sha256", "scheduleCron": "0 2 * * *" }
  },
  "mirrors": [
