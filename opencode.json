{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-orchestrator",
    "@slkiser/opencode-quota"
  ],
  "mcp": {
    "n9router": {
      "type": "remote",
      "url": "http://localhost:20128/v1",
      "enabled": false
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "git *": "allow",
      "npm *": "allow",
      "node *": "allow",
      "python *": "allow",
      "powershell *": "allow",
      "*": "ask"
    }
  }
}
