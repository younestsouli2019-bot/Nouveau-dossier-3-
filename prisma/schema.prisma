model BankAccount {
  id              String   @id @default(cuid())
  label           String
  accountType     String   // bank_wire, crypto_wallet, vcc_issuer, internal_pool
  accountNumber   String?  // IBAN, wallet address, or internal ref
  balance         Float    @default(0)
  currency        String   @default("USD")
  isActive        Boolean  @default(true)
  isPrimary       Boolean  @default(false)
  provider        String?  // banking_circle, payoneer, stripe, wise
  metadata        String?  // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  paymentIntents  PaymentIntent[]
}

model PaymentIntent {
  id              String   @id @default(cuid())
  bankAccountId   String
  bankAccount     BankAccount @relation(fields: [bankAccountId], references: [id])
  idempotencyKey  String   @unique
  amount          Float
  currency        String   @default("USD")
  direction       String   // inbound, outbound
  status          String   @default("PENDING_REASONING")
  // PENDING_REASONING â†’ AUTHORIZED â†’ EXECUTING â†’ SETTLED â†’ RECONCILED
  // or: PENDING_REASONING â†’ DENIED
  destination     String?  // target account or wallet
  source          String?  // source of funds
  description     String?
  failureReason   String?
  approvedBy      String?  // MFA approver
  approvedAt      DateTime?
  executedAt      DateTime?
  settledAt       DateTime?
  reconciledAt    DateTime?
  wireExecutions  WireExecutionLog[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PaymentEscalation {
  id              String   @id @default(cuid())
  payoutBatchId   String
  batch           PayoutBatch @relation(fields: [payoutBatchId], references: [id])
  batchNumber     String
  provider        String   // banking_circle, payoneer, stripe, wise, unknown
  amount          Float
  currency        String   @default("USD")
  itemCount       Int      @default(0)
  severity        String   // L1, L2, L3, CRITICAL
  status          String   @default("open") // open, investigating, resolved
  submittedAt     DateTime
  escalatedAt     DateTime @default(now())
  actionTaken     String?  // JSON array of { date, action, by, detail }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WireExecutionLog {
  id              String   @id @default(cuid())
  paymentIntentId String
  paymentIntent   PaymentIntent @relation(fields: [paymentIntentId], references: [id])
  channel         String   // iso20022, swift_mt103, fedwire, crypto_onchain, internal_ledger
  status          String   // submitted, confirmed, failed, reversed
  providerRef     String?  // external reference from payment provider
  proofHash       String?  // SHA-256 of confirmation evidence
  feeAmount       Float    @default(0)
  netAmount       Float?
  metadata        String?  // JSON with raw response
  submittedAt     DateTime @default(now())
  confirmedAt     DateTime?
  createdAt       DateTime @default(now())
}

// â”€â”€â”€ EXTERNAL PERSISTENCE & FAILOVER MODELS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model StateCheckpoint {
  id            String   @id @default(cuid())
  workflowId    String   @unique
  state         String
  version       Int      @default(1)
  status        String   @default("running")
  lastHeartbeat DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workflowId])
  @@index([status])
  @@index([lastHeartbeat])
}

model DbEpoch {
  id        String   @id @default("primary")
  epoch     Int      @default(1)
  leaderId  String?
  lockUntil DateTime?
  updatedAt DateTime @updatedAt
}
