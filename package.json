{
  "name": "nouveau-dossier-3",
  "version": "3.0.0",
  "description": "Autonomous revenue collection, settlement, and financial operations — Feed-Attijari edition (Wise-first)",
  "type": "module",
  "scripts": {
    "setup:wise": "node scripts/setup-wise.mjs",
    "setup:env": "test -f .env || cp .env.example .env && echo 'Edit .env with your Wise API key, then run: npm run setup:wise'",
    "setup:secrets": "bash setup-gh-secrets.sh --from .env",
    "setup:secrets:dry": "bash setup-gh-secrets.sh --dry-run",
    "auto-settle": "node --import ./scripts/env.mjs scripts/auto-settle-bank-wire.mjs",
    "auto-payout": "node --import ./scripts/env.mjs scripts/auto-payout.mjs",
    "reconcile": "node --import ./scripts/env.mjs scripts/reconcile-settlements.mjs",
    "notify": "node --import ./scripts/env.mjs scripts/notify-owner.mjs",
    "financial:status": "node --import ./scripts/env.mjs scripts/query-financial-status.mjs",
    "wire:instruction": "node --import ./scripts/env.mjs scripts/generate-swift-mt103.mjs",
    "payout:create": "node --import ./scripts/env.mjs scripts/create-payout-batch.mjs",
    "agent:unfreeze": "node --import ./scripts/env.mjs scripts/unfreeze-agent.mjs",
    "wise:settle": "node --import ./scripts/env.mjs scripts/settle-owner-wise.mjs",
    "wires:pending": "node --import ./scripts/env.mjs scripts/process-pending-wires.mjs",
    "feed:attijari": "node --import ./scripts/env.mjs scripts/attijari-autofill.mjs --list && node --import ./scripts/env.mjs scripts/attijari-autofill.mjs",
    "feed:attijari:setup": "node --import ./scripts/env.mjs scripts/attijari-autofill.mjs --setup",
    "feed:attijari:daemon": "node --import ./scripts/env.mjs scripts/feed-attijari-daemon.mjs",
    "feed:attijari:watchdog": "node --import ./scripts/env.mjs scripts/feed-attijari-watchdog.mjs",
    "feed:attijari:install-autorun": "install-autorun.cmd",
    "feed:attijari:loop": "bash keep-on-loop.sh --daemon",
    "portal:instructions": "node --import ./scripts/env.mjs scripts/generate-portal-instructions.mjs",
    "seed:offline-ledger": "node --import ./scripts/env.mjs scripts/seed-offline-ledger-recovery.mjs",
    "quick-set": "node --import ./scripts/env.mjs scripts/quick-set.mjs",
    "supervisor:loop": "node --import ./scripts/env.mjs scripts/supervisor-loop.mjs",
    "deadman:check": "node --import ./scripts/env.mjs scripts/bank-wire-deadman.mjs --hours=24",
    "wire:confirm": "node --import ./scripts/env.mjs scripts/wire-confirm.mjs",
    "circuit:check": "node --import ./scripts/env.mjs scripts/circuit-breaker.mjs",
    "setup:crypto": "node --import ./scripts/env.mjs scripts/setup-crypto.mjs",
    "crypto:payout": "node --import ./scripts/env.mjs scripts/crypto-payout.mjs",
    "crypto:chains": "node --import ./scripts/env.mjs scripts/crypto-payout.mjs --list-chains",
    "deploy": "pwsh -File deploy-feed-attijari.ps1"
  },
  "optionalDependencies": {
    "puppeteer-core": "^23.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "attijari",
    "wise",
    "paypal",
    "autonomous",
    "settlement",
    "swift-mt103",
    "puppeteer",
    "self-healing"
  ],
  "author": "M TSOULI YOUNES <younestsouli2019@gmail.com>",
  "license": "UNLICENSED",
  "private": true
}


