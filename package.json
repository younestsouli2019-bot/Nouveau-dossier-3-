{
  "name": "charibaas-client",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "ChariBaaS autonomous AI agentic swarm — crowdsourcing HIT revenue automation",
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "security:scan": "node ./src/security/cli.mjs scan",
    "security:status": "node ./src/security/cli.mjs status",
    "security:recovery": "node ./src/security/cli.mjs recovery",
    "security:legal": "node ./src/security/cli.mjs legal-report",
    "wallet:check": "node ./scripts/check-chain-wallets.mjs",
    "owner:crypto:withdraw": "node ./scripts/execute-crypto-withdraw.mjs",
    "vercel:prepare": "node \"Nouveau dossier (3)/scripts/generate-vercel-output.mjs\"",
    "reconcile:payouts": "node ./scripts/reconcile_payouts.mjs",
    "swarm:add:agents": "node ./src/charibaas/orchestrator.mjs --add-agents",
    "swarm:headhunter:once": "node \"Nouveau dossier (3)/scripts/headhunter-once.mjs\"",
    "autonomous:once": "node ./src/mcp/autonomous_daemon.mjs --once",
    "live:readiness:ping": "node ./src/mcp/webhook_listener.mjs --ping",
    "catalogue:ultimate": "node \"Nouveau dossier (3)/scripts/generate-catalogue-ultimate.mjs\"",
    "catalogue:pdfkit": "node \"Nouveau dossier (3)/scripts/generate-catalogue-pdfkit.mjs\"",
    "revenue:engines": "node ./src/revenue-engines/registry.mjs run-all",
    "settlement:status": "node ./src/settlement/settlement.mjs status",
    "settlement:selftest": "node ./src/settlement/settlement.mjs selftest",
    "settlement:net": "node ./src/settlement/settlement.mjs net",
    "settlement:sahl:status": "node ./src/settlement/settlement.mjs sahl-status",
    "settlement:payout": "node ./src/settlement/settlement.mjs payout",
    "settlement:charipay:status": "node ./src/settlement/settlement.mjs charipay-status",
    "settlement:payzone:status": "node ./src/settlement/settlement.mjs payzone-status",
    "settlement:xs2a:status": "node ./src/settlement/settlement.mjs xs2a-status",
    "settlement:receivables:status": "node ./src/settlement/settlement.mjs receivables-status",
    "settlement:receivables:audit": "node ./src/settlement/settlement.mjs receivables-audit",
    "settlement:revenue:settle": "node ./src/settlement/settlement.mjs settle-revenue",
    "vault:settlement-seal": "node ./src/secure-cloud.mjs settlement-seal",
    "vault:snapshot": "node ./src/secure-cloud.mjs vault-snapshot",
    "vault:status": "node ./src/secure-cloud.mjs health"
  },
  "dependencies": {
    "chari-baas-client": "^1.0.0"
  },
  "optionalDependencies": {
    "ccxt": "^4.0.0",
    "ethers": "^6.0.0",
    "dotenv": "^16.0.0"
  }
}
