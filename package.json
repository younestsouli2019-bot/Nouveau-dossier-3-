{
  "name": "supply-chain-swarm",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "if [ -n \"$DATABASE_URL\" ]; then prisma generate; else echo \"skip prisma generate (no DATABASE_URL)\"; fi",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed-pos": "node scripts/seed-pos.mjs",
    "carrier:health": "node -e \"import('./src/lib/carrier-tracking.ts').then(m => m.healthCheck().then(console.log))\"",
    "carrier:acquire": "tsx scripts/carrier-acquire-sweep.ts",
    "prod:migrate": "tsx scripts/apply-crbt-migration.ts",
    "proc:reconcile": "tsx scripts/proc-reconcile.ts",
    "proc:status": "tsx scripts/proc-status-check.ts",
    "proc:waybills": "node scripts/apply-waybills.mjs",
    "guard:selftest": "node --import tsx scripts/url-guard-self-test.mjs",
    "audit:truth": "node scripts/truth-invariant-audit.mjs",
    "payout:wise": "node --import tsx scripts/wise-sample-workflow.mjs",
    "payout:paypal": "node --import tsx scripts/paypal-payout-workflow.mjs",
    "edge:plan": "node --import tsx scripts/edge-plan-tool.mjs",
    "swarm:tick:clickless": "node scripts/swarm-clickless-tick.mjs",
    "rail:bankingcircle": "node scripts/verify-banking-circle-connect.mjs",
    "rail:funding": "node scripts/rail-funding-monitor.mjs",
    "audit:proof": "node scripts/remediate-proof-gaps.mjs",
    "proc:watchdog": "node scripts/procurement-delivery-watchdog.mjs",
    "proc:queue": "node scripts/procurement-payment-queue.mjs",
    "settlement:worklist": "node scripts/settlement-worklist.mjs",
    "po:execution": "node scripts/po-execution-queue.mjs",
    "rail:table": "node scripts/payment-routing-table.mjs",
    "po:orchestrator": "node scripts/po-fulfillment-orchestrator.mjs",
    "wallet:balance": "node scripts/evm-wallet-rail.mjs --action balance",
    "wallet:send": "node scripts/evm-wallet-rail.mjs --action send",
    "wallet:payout": "node scripts/owner-payout-evm.mjs",
    "wallet:ton": "node scripts/ton-wallet-rail.mjs",
    "wallet:status": "node scripts/evm-wallet-rail.mjs --action balance && node scripts/ton-wallet-rail.mjs --action balance",
    "binance:balance": "node scripts/binance-rail.mjs --action balance",
    "binance:networks": "node scripts/binance-rail.mjs --action networks",
    "binance:withdraw": "node scripts/binance-rail.mjs --action withdraw",
    "audit:all": "npm run typecheck && npm run audit:truth && npm run guard:selftest"
  },
  "dependencies": {
    "@base44/sdk": "^0.8.13",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.0.0",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.0.0",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.0",
    "@radix-ui/react-tabs": "^1.0.0",
    "@radix-ui/react-tooltip": "^1.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "ccxt": "^4.5.76",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.0.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.0.0",
    "framer-motion": "^13.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.34.0",
    "next": "^16.3.4",
    "next-themes": "^0.3.0",
    "pg": "^8.23.0",
    "postcss": "^8.5.26",
    "prisma": "^7.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.0.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^8.57.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
