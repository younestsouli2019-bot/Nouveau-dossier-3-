# Base44 backend API host (do NOT point to Wix)
BASE44_API_URL=https://api.base44.yourdomain.com
# Or use BASE44_SERVER_URL if you prefer that key
BASE44_SERVER_URL=https://api.base44.yourdomain.com

# App identity (no secrets committed here)
BASE44_APP_ID=YOUR_BASE44_APP_ID
BASE44_SERVICE_TOKEN=YOUR_BASE44_SERVICE_TOKEN

# Live mode flags
SWARM_LIVE=true
BUNKER_MODE=false
BASE44_OFFLINE=false
BASE44_OFFLINE_MODE=false

# PayPal PPP2 enablement for acceptance/payout rails
PAYPAL_PPP2_APPROVED=true
PAYPAL_PPP2_ENABLE_SEND=true
PPP2_APPROVED=true
PPP2_ENABLE_SEND=true
PAYPAL_DISABLED=false

# Owner accounts
OWNER_PAYPAL_EMAIL=younestsouli2019@gmail.com
OWNER_BENEFICIARY_NAME=Owner
OWNER_IBAN=YOUR_OWNER_IBAN
OWNER_SWIFT=YOUR_OWNER_SWIFT
MOROCCAN_BANK_RIB=007810000448500030594182
BANK_WIRE_ENABLE=true
BANK_WIRE_PROVIDER=LIVE
OWNER_BENEFICIARY_ALLOWLIST_JSON=["YOUR_OWNER_IBAN_OR_RIB"]
PAYMENT_ROUTING_PRIORITY=bank_transfer,crypto,paypal,payoneer_standard
RAIL_PRIORITY=bank_transfer,crypto,paypal,payoneer_standard

