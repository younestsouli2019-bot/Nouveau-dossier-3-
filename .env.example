# Base44 backend API host (do NOT point to Wix)
BASE44_API_URL=https://api.base44.yourdomain.com
# Or use BASE44_SERVER_URL if you prefer that key
BASE44_SERVER_URL=https://api.base44.yourdomain.com

# App identity (no secrets committed here)
BASE44_APP_ID=YOUR_BASE44_APP_ID
BASE44_SERVICE_TOKEN=YOUR_BASE44_SERVICE_TOKEN

# Live mode flags
SWARM_LIVE=true
BUNKER_MODE=false
BASE44_OFFLINE=false
BASE44_OFFLINE_MODE=false

# ==== MT103 dispute-resolution email agents (live SMTP) ====
# The escalation daemon sends real emails to the bank only when these are set.
# No SMTP creds => daemon runs in degraded mode and drafts .eml to the outbox
# queue, retrying with exponential backoff when connectivity returns (DTN style).
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=treasury-automation@realworldcerts.com
SMTP_PASS=YOUR_SMTP_PASS
SMTP_FROM=treasury-automation@realworldcerts.com
SMTP_REQUIRE_TLS=true
SMTP_AUTH_METHOD=auto
# Resilience / degraded-mode tuning
ESCALATION_DAEMON_INTERVAL_MS=3600000
ESCALATION_FORCE_OFFLINE=false

# PayPal PPP2 enablement for acceptance/payout rails
PAYPAL_PPP2_APPROVED=true
PAYPAL_PPP2_ENABLE_SEND=true
PPP2_APPROVED=true
PPP2_ENABLE_SEND=true
PAYPAL_DISABLED=false

# Owner accounts
OWNER_PAYPAL_EMAIL=younestsouli2019@gmail.com
OWNER_BENEFICIARY_NAME=Owner
OWNER_IBAN=YOUR_OWNER_IBAN
OWNER_SWIFT=YOUR_OWNER_SWIFT
MOROCCAN_BANK_RIB=007810000448500030594182
BANK_WIRE_ENABLE=true
BANK_WIRE_PROVIDER=LIVE
OWNER_BENEFICIARY_ALLOWLIST_JSON=["YOUR_OWNER_IBAN_OR_RIB"]
PAYMENT_ROUTING_PRIORITY=bank_transfer,crypto,paypal,payoneer_standard
RAIL_PRIORITY=bank_transfer,crypto,paypal,payoneer_standard

# Plaid
PLAID_CLIENT_ID=YOUR_PLAID_CLIENT_ID
PLAID_SECRET=YOUR_PLAID_SECRET
PLAID_ENV=sandbox
PLAID_PRODUCTS=auth,transactions,identity
PLAID_COUNTRY_CODES=US,CA,GB
PLAID_REDIRECT_URI=https://yourapp.example.com/plaid/oauth/callback
PLAID_WEBHOOK_URL=https://yourapp.example.com/plaid/webhook
PLAID_APP_URL=https://yourapp.example.com

# ==== Education storefronts (swarm revenue) ====
