GDRIVE_ENABLED=false
GDRIVE_FOLDER_IDS=
GDRIVE_ACCESS_TOKEN=YOUR_GDRIVE_ACCESS_TOKEN
GDRIVE_CLIENT_SECRET_JSON=YOUR_GDRIVE_SERVICE_ACCOUNT_JSON

# Course humanization (never reveal agentic origin in the school)
EDU_HUMANIZE=true
EDU_INSTRUCTOR_NAME=Younes Souli
EDU_INSTRUCTOR_TITLE=Lead Instructor
EDU_INSTRUCTOR_BIO=Practicing engineer and instructor who teaches the way I wish I'd been taught â€” with clear explanations and plenty of working examples.


# --- Autonomous procurement execution engine ---
# Fully autonomous agentic procurement (owner hands-free).
# Approval gate: auto-signed via encrypted corporate purchasing key.
# Live PO marking requires SWARM_LIVE=true AND PROCUREMENT_EXECUTION_LIVE=true.
# Otherwise the engine drafts every PO (mode=draft) without touching a wallet.
PROCUREMENT_EXECUTION_LIVE=false
PROCUREMENT_DAEMON_INTERVAL_MS=3600000
PROCUREMENT_BATCH_SIZE=20
PROCUREMENT_BATCH_WINDOW_MS=86400000
PROCUREMENT_URGENT_HOURS=24
# Corporate purchasing key: explicit path, else ./owner_private.key, else
# decrypted from ./backup/owner_private.key.enc using OWNER_KEY_BACKUP_SECRET.
PURCHASING_KEY_PATH=

# --- Regulatory letters dispatch (Lettre de Réclamation / Plainte BAM) ---
# Bank Al-Maghrib supervision recipient (Direction de la Supervision Bancaire).
# Without this, the BAM letter is drafted with a placeholder recipient.
BAM_SUPERVISION_EMAIL=
# CC override for the Attijariwafa Bank letter (defaults to case escalation desk).
ESCALATION_BANK_CC=
