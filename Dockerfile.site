FROM node:22-alpine

ENV NODE_ENV=production
ENV SITE_PORT=8080
ENV SITE_RATE_MAX=30
ENV SITE_RATE_WINDOW_MS=60000
ENV SITE_ALLOWLIST=

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci || npm i --only=prod

COPY src ./src
COPY scripts ./scripts
RUN mkdir -p dist_rwc

# Generate feed at build time (optional; runtime script also available)
ENV SITE_PUBLIC_URL=https://realworldcerts.com
# Generate feed if script exists; tolerate failure in minimal API-only deployments
RUN node ./scripts/generate-feed.mjs || true

EXPOSE 8080
CMD ["node", "./src/site-server.mjs"]
