{
  "name": "l2-ecosystems-monitor",
  "version": "1.0.0",
  "description": "L2 Ecosystems: Daily transaction monitor for owner accounts across Arbitrum, Optimism, Base, Polygon zkEVM, Linea, and Scroll",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "server": "node src/server.js",
    "daemon": "node src/daemon.js",
    "dev": "nodemon src/index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop l2-ecosystems",
    "pm2:logs": "pm2 logs l2-ecosystems",
    "docker:build": "docker build -t l2-ecosystems .",
    "docker:up": "docker-compose up -d",
    "docker:logs": "docker-compose logs -f",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "scan": "node src/cli/scan.js"
  },
  "dependencies": {
    "ethers": "^6.13.0",
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "winston": "^3.14.0",
    "winston-daily-rotate-file": "^5.0.0",
    "p-queue": "^8.0.1",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
