# ═══════════════════════════════════════════════════════════════
# L2 ECOSYSTEMS MONITOR - Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── General ──
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ── Owner Accounts (comma-separated) ──
# These are the wallet addresses the daemon monitors for incoming transactions.
# Private keys are ONLY needed if you plan to submit transactions (optional).
OWNER_ADDRESSES=0xYourAddress1,0xYourAddress2,0xYourAddress3

# ── Private Keys (ONLY if submitting transactions) ──
# Leave empty for monitor-only mode. NEVER share these.
OWNER_PRIVATE_KEYS=

# ── L2 RPC Endpoints ──
# Use Alchemy, Infura, QuickNode, or public RPCs
RPC_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/YOUR_ARBITRUM_KEY
RPC_OPTIMISM=https://opt-mainnet.g.alchemy.com/v2/YOUR_OPTIMISM_KEY
RPC_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_BASE_KEY
RPC_POLYGON_ZKEVM=https://zkevm-rpc.com
RPC_LINEA=https://rpc.linea.build
RPC_SCROLL=https://rpc.scroll.io

# ── Fallback RPCs (optional, comma-separated) ──
FALLBACK_RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
FALLBACK_RPC_OPTIMISM=https://mainnet.optimism.io
FALLBACK_RPC_BASE=https://mainnet.base.org
FALLBACK_RPC_POLYGON_ZKEVM=
FALLBACK_RPC_LINEA=
FALLBACK_RPC_SCROLL=

# ── Daemon Configuration ──
# Cron schedule for daily scans (default: every hour)
DAEMON_CRON=0 * * * *
# How many blocks to scan per cycle (0 = auto-detect from last scan)
BLOCKS_PER_SCAN=1000
# Maximum concurrent RPC requests per provider
MAX_CONCURRENT_REQUESTS=5
# Request timeout in ms
RPC_TIMEOUT=30000

# ── Transaction Filters ──
# Minimum ETH value to track (in ETH)
MIN_TX_VALUE_ETH=0.001
# Track ERC-20 transfers (true/false)
TRACK_ERC20=true
# Specific ERC-20 token addresses to watch (comma-separated, empty = all)
WATCH_TOKENS=

# ── Notifications (optional) ──
# Slack webhook URL
SLACK_WEBHOOK_URL=
# Telegram bot token + chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord webhook URL
DISCORD_WEBHOOK_URL=

# ── Database (optional, defaults to local JSON files) ──
DATABASE_URL=

# ── API Security ──
API_KEY=your-secure-api-key-here
JWT_SECRET=your-jwt-secret-here
