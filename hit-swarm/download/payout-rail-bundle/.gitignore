# .gitignore additions for the payout-rail bundle.
# apply.sh will append these to the repo's .gitignore if not already present.

# Secrets — never commit
.env
.env.local
.env.*.local
secrets/
*.pem
*.key

# Payout runtime data — contains recipient hashes and external tx IDs,
# should be treated as PII / compliance records. Persist via Actions
# artifacts or external secure storage, not in the repo.
data/payouts/audit.jsonl
data/kyc/kyc-db.json
