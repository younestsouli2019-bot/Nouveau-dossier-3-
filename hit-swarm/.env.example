# HIT Swarm — Autonomous Revenue Engine
# Copy to .env and fill in your real values. NEVER commit .env.
# COME-WHAT-MAY RULE: swarm revenue only ever settles to the OWNER below.
# Fail-closed: with no OWNER_* values configured, payouts are locked.

# --- Base44 API (backend for agents/missions/payouts) ---
B44_BASE_URL=https://agent-swarm-efe0bd7e.base44.app/api
B44_API_KEY=

# --- Prisma/SQLite (optional; Base44 is the primary store) ---
DATABASE_URL=file:./dev.db

# --- Owner identity (beneficiary of ALL swarm revenue) ---
OWNER_LEGAL_NAME=Younes Tsouli
OWNER_CIN=
OWNER_EMAIL=

# --- Owner payout destinations ---
OWNER_PAYPAL_EMAIL=
OWNER_PAYONEER_EMAIL=
OWNER_PAYONEER_ID=
OWNER_IBAN=
MOROCCAN_BANK_RIB=
OWNER_BANK_ACCOUNT_NUM=
TRUST_WALLET_ADDRESS=
TRUST_WALLET_USDT_ERC20=
TRUST_WALLET_USDT_BEP20=
BYBIT_USDT_ERC20=

# --- Explicit beneficiary allowlists (all must resolve to the owner) ---
OWNER_BENEFICIARY_ALLOWLIST_JSON=[]
AUTONOMOUS_ALLOWED_BANK_WIRE_ACCOUNTS=
BASE44_ALLOWED_BANK_WIRE_ACCOUNTS=
PAYOUT_ALLOWED_BANK_WIRE_ACCOUNTS=
