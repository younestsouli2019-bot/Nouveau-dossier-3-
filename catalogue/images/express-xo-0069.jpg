.wp-site-blocks .has-margin-block-start-zero {
   margin-block-start: 0;
}

.wc-block-product-categories select {
    font-size: var(--wp--preset--font-size--medium);
    height: 28px;
    margin-right: 0;
}

.woocommerce.wc-block-catalog-sorting select.orderby {
   font-size: var(--wp--preset--font-size--medium);
}

.wc-blocks-pattern-header-essential .wp-block-button.is-style-outline .wp-block-button__link:hover {
    background-color: transparent;
    color: var(--wp--preset--color--contrast-2);
    border-color: transparent;
}

.wc-block-grid__products .wc-block-grid__product .wp-block-button__link.wp-element-button {
    background-color: transparent;
    color: var(--wp--preset--color--contrast);
    border: 1px solid var(--wp--preset--color--contrast);
}

.wc-block-grid__products .wc-block-grid__product a.wp-block-button__link.wp-element-button:hover {
    background-color: var(--wp--preset--color--contrast);
    color: var(--wp--preset--color--base);
}

.font-size-md {
    font-size: 1.2rem;
}

.font-size-lg {
    font-size: 1.4rem;
}

.font-size-md .wp-element-button, .font-size-md .wp-block-button__link {
    font-size: 1.2rem;
}

.font-size-lg .wp-element-button, .font-size-lg .wp-block-button__link {
    font-size: 1.4rem;
}

.wc-block-product-categories__button {
    background-color: var(--wp--preset--color--contrast);
    border-color: var(--wp--preset--color--contrast);
    color: var(--wp--preset--color--base);
}

