{
  "Edr": {
    "SysmonChannel": "Microsoft-Windows-Sysmon/Operational",
    "MonitoredEventIds": [ 1, 3, 5, 7, 8, 9, 10, 11, 13, 17, 18, 23 ],
    "ChannelCapacity": 10000,
    "FallbackPollIntervalSeconds": 60,

    "DatabasePath": "C:\\ProgramData\\EdrBrain\\edr.db",
    "BatchInsertSize": 500,
    "CacheSizeMb": 64,
    "EventRetentionDays": 30,
    "DiskSpaceWarningGb": 5,
    "DiskSpaceCriticalGb": 1,

    "PruneIntervalMinutes": 5,
    "TerminatedProcessRetentionMinutes": 30,
    "MemoryWarningMb": 200,
    "MemoryCriticalMb": 500,

    "AlertThreshold": 75,
    "ChainLengthWeight": 15,
    "EncodedCommandBonus": 30,
    "UnsignedProcessBonus": 15,
    "LolbinBonus": 25,
    "NetworkC2Bonus": 20,
    "RegistryPersistenceBonus": 20,

    "ResponsePolicy": "AlertOnly",
    "ResponseCooldownSeconds": 300,

    "RulesPath": "Detection/rules",
    "RuleReloadIntervalSeconds": 60,

    "EnableSiemForwarding": false,
    "SiemEndpoint": "",
    "SiemApiKey": "",

    "HealthCheckIntervalSeconds": 30
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "EdrBrain": "Information"
    }
  }
}
